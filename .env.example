# S3-compatible provider (Cloudflare R2, AWS S3, Backblaze, Wasabi, MinIO)
# For R2, set the endpoint and region shown in the Cloudflare dashboard.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
# For AWS S3, remove S3_ENDPOINT and set the bucket region instead.
S3_BUCKET=your-bucket
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
# Optional for temporary AWS credentials.
# S3_SESSION_TOKEN=
# Optional quota estimate used by automatic routing (bytes).
# S3_CAPACITY_BYTES=1099511627776

# Google OAuth web application for Google sign-in and optional Drive storage.
# Add this exact redirect URI to the OAuth client in Google Cloud Console;
# sign-in and Drive storage share this callback URL:
# http://localhost:4173/api/providers/google/callback
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REDIRECT_URI=http://localhost:4173/api/providers/google/callback

# Generate a unique 32-byte (64 hex character) key, e.g.:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep this key safe: Google refresh tokens saved by NDrive are encrypted with it.
CREDENTIAL_ENCRYPTION_KEY=replace-with-64-hex-characters

# Optional: permit new email/password and Google sign-up after the first owner is created.
# ALLOW_SIGNUPS=false
# Optional maximum for upload API requests (default 5 GiB).
# MAX_UPLOAD_BYTES=5368709120
# Optional location for the embedded SQLite database.
# NDRIVE_DB_FILE=./data/ndrive.sqlite

# Optional. Defaults to the encrypted credential file under ./data.
# NDRIVE_SECRETS_FILE=./data/provider-secrets.json
